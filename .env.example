# --- JOBOS ENVIRONMENT CONFIGURATION ---

# Django Production Settings
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# PostgreSQL Database Configuration
POSTGRES_DB=jobos
POSTGRES_USER=jobos_user
POSTGRES_PASSWORD=jobos_secure_password_123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1

# AI Job Description Parser (Google Gemini API Key)
# Optional: If left blank, JobOS automatically uses the built-in deterministic NLP rule-based parser!
GEMINI_API_KEY=""

